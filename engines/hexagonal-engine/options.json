{
  "$schema": "../options.schema.json",
  "sections": [
    {
      "name": "Board",
      "options": [
        {
          "name": "sideLength",
          "label": "Side Length",
          "type": "number",
          "defaultValue": 2,
          "minimum": 2
        },
        {
          "name": "numToConnect",
          "label": "Line Length",
          "type": "number",
          "defaultValue": 3,
          "minimum": 3,
          "maximum": [
            "sideLength"
          ]
        },
        {
          "name": "allowDiagonals",
          "label": "Allow Diagonals",
          "type": "boolean",
          "defaultValue": false
        }
      ]
    },
    {
      "name": "Pieces & Turns",
      "options": [
        {
          "name": "pieces",
          "label": "Pieces",
          "type": "pieces",
          "defaultValue": "1,1",
          "minimumPieces": 1,
          "maximumPieces": 10,
          "canWinDefault": true
        },
        {
          "name": "turnPattern",
          "label": "Turns",
          "type": "turns",
          "defaultValue": "0-0,1-1",
          "minimumTurns": [
            "numPlayers"
          ],
          "players": 3,
          "pieces": [
            "pieces"
          ]
        }
      ]
    }
  ],
  "issueDetection": true
}
