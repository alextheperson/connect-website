{
  "$schema": "../options.schema.json",
  "sections": [
    {
      "name": "Board",
      "options": [
        {
          "name": "boardWidth",
          "label": "Board Width",
          "type": "number",
          "defaultValue": 3,
          "minimum": 3
        },
        {
          "name": "boardHeight",
          "label": "Board Height",
          "type": "number",
          "defaultValue": 3,
          "minimum": 3
        },
        {
          "name": "numToConnect",
          "label": "Line Length",
          "type": "number",
          "defaultValue": 3,
          "minimum": 3,
          "maximum": [
            "boardWidth",
            "boardHeight"
          ]
        },
        {
          "name": "allowDiagonals",
          "label": "Allow Diagonals",
          "type": "boolean",
          "defaultValue": true
        },
        {
          "name": "gravityChangeFrequency",
          "label": "",
          "multiline": false,
          "type": "enum",
          "defaultValue": "round",
          "options": [
            {
              "value": "turn",
              "displayName": "Change Gravity Every Turn"
            },
            {
              "value": "round",
              "displayName": "Change Gravity Every Round"
            }
          ]
        }
      ]
    },
    {
      "name": "Pieces & Turns",
      "options": [
        {
          "name": "pieces",
          "label": "Pieces",
          "type": "pieces",
          "defaultValue": "1,1",
          "minimumPieces": 1,
          "maximumPieces": 10,
          "canWinDefault": true
        },
        {
          "name": "turnPattern",
          "label": "Turns",
          "type": "turns",
          "defaultValue": "0-0,1-1",
          "minimumTurns": [
            "numPlayers"
          ],
          "players": [
            "numPlayers"
          ],
          "pieces": [
            "pieces"
          ]
        },
        {
          "name": "gravityPattern",
          "label": "Gravity Angles",
          "type": "directions",
          "defaultValue": "0,1",
          "minimumTurns": 1
        }
      ]
    }
  ],
  "issueDetection": true
}
