{
  "$schema": "../options.schema.json",
  "sections": [
    {
      "name": "Board",
      "options": [
        {
          "name": "boardWidth",
          "label": "Board Width",
          "type": "number",
          "defaultValue": 3,
          "minimum": 3
        },
        {
          "name": "boardHeight",
          "label": "Board Height",
          "type": "number",
          "defaultValue": 3,
          "minimum": 3
        },
        {
          "name": "numToConnect",
          "label": "Line Length",
          "type": "number",
          "defaultValue": 3,
          "minimum": 3,
          "maximum": [
            "boardWidth",
            "boardHeight"
          ]
        },
        {
          "name": "depth",
          "label": "Depth",
          "type": "number",
          "defaultValue": 2,
          "minimum": 2
        },
        {
          "name": "allowDiagonals",
          "label": "Allow Diagonals",
          "type": "boolean",
          "defaultValue": true
        },
        {
          "name": "boardVictoryBehavior",
          "label": "When a Board is Won,",
          "type": "enum",
          "multiline": true,
          "options": [
            {
              "value": "block",
              "displayName": "The other player cannot win or move there."
            },
            {
              "value": "unwinnable",
              "displayName": "The other player can move there, but not win."
            },
            {
              "value": "superposition",
              "displayName": "The other player can win the board too."
            }
          ],
          "defaultValue": "block"
        },
        {
          "name": "fullBoardBehavior",
          "label": "When Moving to a Full Board,",
          "type": "enum",
          "multiline": true,
          "options": [
            {
              "value": "anywhere",
              "displayName": "You can move anywhere."
            },
            {
              "value": "illegal",
              "displayName": "The square cannot be played."
            }
          ],
          "defaultValue": "anywhere"
        }
      ]
    },
    {
      "name": "Pieces & Turns",
      "options": [
        {
          "name": "pieces",
          "label": "Pieces",
          "type": "pieces",
          "defaultValue": "1,1",
          "minimumPieces": 1,
          "maximumPieces": 10,
          "canWinDefault": true
        },
        {
          "name": "turnPattern",
          "label": "Turns",
          "type": "turns",
          "defaultValue": "0-0,1-1",
          "minimumTurns": [
            "numPlayers"
          ],
          "players": 3,
          "pieces": [
            "pieces"
          ]
        }
      ]
    }
  ]
}
