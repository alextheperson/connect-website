{
  "$schema": "https://json.schemastore.org/tsconfig",
  "compilerOptions": {
    "module": "nodenext",
    "noImplicitAny": true,
    "preserveConstEnums": true,
    "sourceMap": true,
    "forceConsistentCasingInFileNames": true,
    "strict": true,
    "lib": [
      "ESNext"
    ],
    "esModuleInterop": true,
    "resolveJsonModule": true,
  },
  "include": [
    "public/**/*",
    "src/**/*",
    "engines/**/*",
    "app.ts"
  ],
  "exclude": [
    "**/*.spec.ts"
  ]
}
